# ============================================
# GIO910 - SUPABASE CONFIGURATION
# Versi: 1.0.0
# Tanggal: 2026-11-26
# ============================================

# Supabase Configuration (otomatis terisi di Supabase)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Google Service Account (untuk akses Sheets, Drive, Calendar, Gmail)
# Generate di: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account-email@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Linear API Key
# Generate di: https://linear.app/settings/api
LINEAR_API_KEY="your-linear-api-key"

# Notion API Key
# Generate di: https://www.notion.so/my-integrations
NOTION_API_KEY="your-notion-api-key"

# Application Configuration
NODE_ENV="production"
APP_VERSION="1.0.0"
